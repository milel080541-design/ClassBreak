# 네이버 클라우드 콘솔 > NAVER API HUB Application의 인증 정보 (지역 검색)
# Maps Application의 Client ID와 다른 키입니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ODsay LAB의 대중교통 경로 검색 API 키 (버스·지하철)
ODSAY_API_KEY=
# Web 플랫폼 키일 때 ODsay에 등록한 URI와 똑같이 (기본값 http://localhost, 포트 없이)
# ODSAY_REFERER=http://localhost

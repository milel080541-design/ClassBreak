{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/handler.py": {
      "maxDuration": 60,
      "includeFiles": "{backend.py,cache_store.py}",
      "excludeFiles": "{.env,.env.*,**/*.md,test.cjs,__pycache__/**,.git/**,transit_cache.json}"
    }
  },
  "rewrites": [
    {"source": "/api/:endpoint(config|places|transit)", "destination": "/api/handler?endpoint=:endpoint"}
  ]
}
